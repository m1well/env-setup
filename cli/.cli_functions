# split file in N files
fsplit() {
  if [ $# -ne 0 ] ; then
    local linesInFile; linesInFile=$(cat "${1}" | wc -l | xargs)
    echo "File has ${linesInFile} lines - how much lines per file do you want? [ENTER]"
    read -r LINES_PER_FILE
    echo "Which file suffix? (standard .txt) [ENTER]"
    read -r SUFFIX
    local filename; filename=$(echo "${1}" | cut -d'.' -f1)
    if [[ -z "${SUFFIX}" ]] ; then
      SFX=".txt"
    else
      SFX=${SUFFIX}
    fi
    split -l "${LINES_PER_FILE}" "${1}"
    local i=1
    local suffixlen=2
    for x in x*; do
      local prefix; prefix=$(printf "%0${suffixlen}d" "${i}")
      mv "$x" "${filename}_${prefix}${SFX}"
      i=$((i+1))
    done
  else
    echo "error: source file missing!"
    return
  fi
}

# format an epoch timestamp with its age, e.g. "2026-11-18 09:37 (6d ago)"
timeWithAge() {
  local now; now=$(date +%s)
  local secs=$((now - ${1})) age
  if (( secs < 3600 )) ; then age="$((secs / 60))m"
  elif (( secs < 86400 )) ; then age="$((secs / 3600))h"
  elif (( secs < 31536000 )) ; then age="$((secs / 86400))d"
  else age="$((secs / 31536000)).$((secs % 31536000 / 3153600))y" ; fi
  echo "$(date -r "${1}" '+%Y-%m-%d %H:%M') (${age} ago)"
}

# analyse a single file - size, lines, dates, git history and a structure peek for md, json and yaml (depth as 2nd arg)
finfo() {
  local f="${1}" depth="${2:-3}"
  if [ ! -f "${f}" ] ; then
    echo "error: no such file '${f}' - e.g. finfo package.json (json/yaml depth as 2nd arg, default 3)"
    return 1
  fi

  local born modified mode owner bytes
  read -r born modified mode owner bytes <<< "$(stat -L -f '%B %m %Sp %Su:%Sg %z' "${f}")"
  local size; size=$(awk -v b="${bytes}" 'BEGIN { split("B KB MB GB", u); i = 1; while (b >= 1024 && i < 4) { b /= 1024; i++ } printf(i == 1 ? "%d %s" : "%.1f %s", b, u[i]) }')

  printf '%-10s %s\n' "path" "$(realpath "${f}")"
  if [ -L "${f}" ] ; then printf '%-10s %s\n' "symlink" "-> $(readlink "${f}")" ; fi
  printf '%-10s %s\n' "type" "$(file -b "${f}")"
  printf '%-10s %s (%s bytes)\n' "size" "${size}" "${bytes}"
  if (( bytes > 0 )) && [ "$(file -b --mime-encoding "${f}")" != "binary" ] ; then
    local lines words chars longest eof=""
    read -r lines words chars longest <<< "$(wc -lwmL < "${f}")"
    if [ -n "$(tail -c1 "${f}")" ] ; then lines=$((lines + 1)) ; eof=", no newline at end of file" ; fi
    printf '%-10s %s lines, %s words, %s chars, longest line %s%s\n' "text" "${lines}" "${words}" "${chars}" "${longest}" "${eof}"
  fi
  printf '%-10s %s\n' "created" "$(timeWithAge "${born}")"
  printf '%-10s %s\n' "modified" "$(timeWithAge "${modified}")"
  printf '%-10s %s %s\n' "mode" "${mode}" "${owner}"

  local dir base; dir=$(dirname "${f}") ; base=$(basename "${f}")
  if git -C "${dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1 ; then
    local state; state=$(git -C "${dir}" status --porcelain --ignored -- "${base}" | cut -c1-2)
    case "${state}" in
      "") state="clean" ;;
      "??") state="untracked" ;;
      "!!") state="ignored" ;;
      " "?) state="modified" ;;
      "A"?) state="added" ;;
      *) state="staged" ;;
    esac
    local log; log=$(git -C "${dir}" log --follow --format='%at|%an|%s' -- "${base}")
    local count=0; [ -n "${log}" ] && count=$(grep -c '' <<< "${log}")
    if (( count > 0 )) ; then state+=", commits: ${count}" ; fi
    printf '%-10s %s\n' "git" "${state}"
    local at author subject
    if (( count > 1 )) ; then
      IFS='|' read -r at author subject <<< "$(tail -1 <<< "${log}")"
      printf '  %-8s %s %s - %s\n' "first" "$(timeWithAge "${at}")" "${author}" "${subject}"
    fi
    if (( count > 0 )) ; then
      IFS='|' read -r at author subject <<< "$(head -1 <<< "${log}")"
      printf '  %-8s %s %s - %s\n' "last" "$(timeWithAge "${at}")" "${author}" "${subject}"
    fi
  fi

  (( bytes > 0 )) || return 0
  # shellcheck disable=SC2016
  local peek='
    def short: if length > 40 then .[0:37] + "..." else . end;
    def describe:
      if type == "object" then "object{\(length)}"
      elif type == "array" then "array[\(length)]"
      elif type == "null" then "null"
      else "\(type) \(tojson | short)" end;
    def merged: (map(select(type == "object")) | add) // (map(select(type == "array")) | add) // .[0];
    def tree($in; $d):
      if $d < 1 then empty
      elif type == "object" then
        (to_entries[0:15][] | "\($in)\(.key): \(.value | describe)", (.value | tree($in + "  "; $d - 1))),
        (if length > 15 then "\($in)... \(length - 15) more keys" else empty end)
      elif type == "array" and length > 0 then
        ([.[] | type] | unique) as $types
        | "\($in)[]: \(if ($types | length) == 1 then merged | describe else $types | join("|") end)",
          (merged | tree($in + "  "; $d - 1))
      else empty end;
    def docLabel:
      if type != "object" then describe
      elif .kind then "\(.kind) \(.metadata.name // "")"
      elif ((.spring.config.activate."on-profile")? // null) then "spring profile \(.spring.config.activate."on-profile")"
      else "keys: \(keys_unsorted | join(", "))" end;
    if $mode == "yaml" then map(select(. != null)) else . end
    | if $mode == "yaml" and length > 1 then
        "  \(length) documents", (.[] | "    - \(docLabel)")
      else
        (if length == 1 then .[0] else . end)
        | ["  root: \(describe)", tree("    "; $depth)]
        | .[0:60][], (if length > 60 then "  ... \(length - 60) more lines - try a smaller depth, e.g. finfo <file> 2" else empty end)
      end'
  local ext; ext=$(tr '[:upper:]' '[:lower:]' <<< "${f##*.}")
  case "${ext}" in
    md|markdown)
      echo "markdown:"
      awk '
        NR == 1 && /^---[[:space:]]*$/ { front = 1 ; next }
        front && /^---[[:space:]]*$/ { front = 0 ; if (keys != "") print "  frontmatter: " keys ; next }
        front { if (match($0, /^[A-Za-z0-9_-]+:/)) keys = keys (keys == "" ? "" : ", ") substr($0, 1, RLENGTH - 1) ; next }
        /^[[:space:]]*(```|~~~)/ { code = !code ; next }
        code { next }
        /^# / { printf "  %5d  %s\n", NR, $0 ; n++ }
        /^## / { printf "  %5d    %s\n", NR, $0 ; n++ }
        END { if (!n) print "  no h1/h2 headings" }
      ' "${f}"
      ;;
    json|jsonl|ndjson)
      echo "json:"
      local src err; src=$(cat "${f}")
      if ! err=$(jq empty <<< "${src}" 2>&1) ; then
        # tsconfig.json & co. are jsonc - a line holding only a comment can never be valid json, so dropping it is safe
        src=$(sed -E '/^[[:space:]]*(\/\/|\/\*.*\*\/[[:space:]]*$)/d' "${f}")
        if ! jq empty <<< "${src}" 2>/dev/null ; then echo "  invalid: ${err}" ; return ; fi
        echo "  jsonc - comment lines skipped"
      fi
      jq -rs --arg mode json --argjson depth "${depth}" "${peek}" <<< "${src}"
      ;;
    yml|yaml)
      echo "yaml:"
      if ! isCommandAvailable "yq" ; then echo "  yq not installed - brew install yq" ; return ; fi
      local json
      if ! json=$(yq -o=json '.' "${f}" 2>&1) ; then echo "  invalid: ${json}" ; return ; fi
      jq -rs --arg mode yaml --argjson depth "${depth}" "${peek}" <<< "${json}"
      ;;
  esac
}

# clean up docker system, volumes and images
dockercleanup() {
  docker system df
  docker system prune -f
  docker volume prune -f
  docker image prune -f
  docker system df
}

# checkout new branch or show message if exists
git_checkout_new_branch() {
  local branch="${1}"
  if git ls-remote --exit-code --heads origin "${branch}" >/dev/null 2>&1; then
    echo "Remote branch exists. Use: git checkout ${branch}" >&2
    return 1
  fi
  git checkout -b "${branch}"
}

# get, checkout and pull dev or develop or development branch
git_current_develop() {
  local branches=(dev develop development)

  for branch in "${branches[@]}"; do
    if git ls-remote --exit-code --heads origin "$branch" &>/dev/null; then
      git checkout "$branch" && git pull --rebase origin "$branch"
      return 0
    fi
  done
  
  echo "no develop branch found"
  return 1
}

# get, checkout and pull main or master branch
git_current_main() {
  local branches=(main master)

  for branch in "${branches[@]}"; do
    if git ls-remote --exit-code --heads origin "$branch" &>/dev/null; then
      git checkout "$branch" && git pull --rebase origin "$branch"
      return 0
    fi
  done

  echo "no main branch found"
  return 1
}

# get, checkout and pull test or testing branch
git_current_test() {
  local branches=(test testing)

  for branch in "${branches[@]}"; do
    if git ls-remote --exit-code --heads origin "$branch" &>/dev/null; then
      git checkout "$branch" && git pull --rebase origin "$branch"
      return 0
    fi
  done

  echo "no test branch found"
  return 1
}

# git push with some options
git_push() {
  local toBranch; toBranch=$(git rev-parse --abbrev-ref HEAD)
  echo "Force push? (press ff to force or just ENTER to normal)"
  read -r FORCE
  if [[ ${FORCE} == "ff" ]] ; then
    echo "Performing force push now..."
    git push origin "${toBranch}" --force-with-lease
  else
    echo "Performing normal push now..."
    git push origin "${toBranch}"
  fi
}

