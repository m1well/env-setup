# find files
fif() {
  if [ $# -ne 0 ] ; then
    local found; found=$(find . -maxdepth 1 -type f -name "*${1}*")
    if [[ -n "${found}" ]] ; then
      echo "${found}"
    else
      echo "Not found in this folder -> search recursively? (Y|n) [ENTER]"
      read -r REPLY
      if [[ ${REPLY} =~ ^[Yy]$ ]] ; then
