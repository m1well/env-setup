### cli functions ###

# print aliases by name
print_aliases() {
  alias | grep "^${1}.*" --color=never
}

# print functions from here (alphabetically)
print_functions() {
  # generated from the definitions below: every snake_case function with its
  # one-line doc comment directly above it. camelCase helpers (e.g.
  # isCommandAvailable) are excluded on purpose.
  awk '
    /^[a-z][a-z0-9_]*\(\) \{/ && prev ~ /^# / {
      fn = $1 ; sub(/\(\).*/, "", fn)
      print fn "() # " substr(prev, 3)
    }
    { prev = $0 }
  ' "${M1WELL_TOOLSUITE_HOME}/env-setup/cli/.cli_functions" | sort
}

# check if a command is available
isCommandAvailable() {
  if command -v "${1}" >/dev/null ; then return 0 ; fi
  return 1
}

# source zshrc and/or bashrc if available
src() {
  local z; z=$(find "${HOME}/" -maxdepth 1 -type f -name ".zshrc")
  if [ "${z}" != "" ] ; then
    source "${HOME}/.zshrc"
    echo ">> sourced .zshrc <<"
  fi
  local b; b=$(find "${HOME}/" -maxdepth 1 -type f -name ".bashrc")
  if [ "${b}" != "" ] ; then
    source "${HOME}/.bashrc"
    echo ">> sourced .bashrc <<"
  fi
}

# edit a file with nvim or vim
ev() {
  if isCommandAvailable "nvim" ; then
    nvim "$@"
  else
    vim "$@"
  fi
}

# print shell color codes
colorcodes() {
  for code in {000..255}; do
    print -P -- "$code: %F{$code}Test%f";
  done
}

# print calendarweek
week() {
  echo "calendar week: $(date +"%V")"
}

# print actual datestrings
datestrings() {
  echo "# up to second"
  echo "-- $(date +"%Y%m%d%H%M%S")"
  echo "-- $(date +"%Y%m%d-%H%M%S")"
  echo "-- $(date +"%Y-%m-%d_%H-%M-%S")"
  echo "# up to minute"
  echo "-- $(date +"%Y%m%d%H%M")"
  echo "-- $(date +"%Y%m%d-%H%M")"
  echo "-- $(date +"%Y-%m-%d_%H-%M")"
  echo "# up to hour"
  echo "-- $(date +"%Y%m%d%H")"
  echo "-- $(date +"%Y%m%d-%H")"
  echo "-- $(date +"%Y-%m-%d_%H")"
  echo "# up to day"
  echo "-- $(date +"%Y%m%d")"
  echo "-- $(date +"%Y-%m-%d")"
  echo "-- $(date +"%Y/%m/%d")"
  echo "-- $(date +"%d.%m.%Y")"
  echo "-- $(date +"%d/%m/%Y")"
}

# print current timestamp (evaluated on each call, not frozen at shell start)
timestamp() {
  date "+%Y-%m-%d %H:%M:%S"
}

# create hyphened url from string
url_from_string() {
  echo "${1}" | tr '[:upper:]' '[:lower:]' | sed -e 's/[-,?]//g' | sed -e 's/  / /g' | sed -e 's/ /-/g'
}

# base64-encode provided string
base64enc() {
  if [ $# -ne 0 ] ; then
    echo -n "${1}" | base64
  else
    echo "error: no string provided"
  fi
}

# base64-decode provided base64 string
base64dec() {
  if [ $# -ne 0 ] ; then
    echo -n "${1}" | base64 -d
  else
    echo "error: no base64 string provided"
  fi
}

# print timestamp seconds and add number of seconds if you want
seconds() {
  local now; now=$(date +%s)
  if [ $# -ne 0 ] ; then
    local future=$((now + ${1}))
    echo "$(date -r ${future}) -- ${future}"
  else
    echo "$(date) -- ${now}"
  fi
}

# generate one uuid (uuid-runtime has to be installed) ore more (if number is given)
uuid() {
  if isCommandAvailable "uuidgen" ; then
    if [ $# -ne 0 ] ; then
      for _ in $(seq 1 "${1}"); do
        uuidgen | tr '[:upper:]' '[:lower:]'
      done
    else
      uuidgen | tr '[:upper:]' '[:lower:]'
    fi
  else
    echo "error: uuidgen has to be installed"
    return
  fi
}

# generate random number with given length (up to 32)
rand_num() {
  if [ -z "${1}" ]; then
    echo "error: set number of digits - e.g. rand_num 12"
    return 1
  fi
  if (( ${1} > 32 )); then
    echo "error: only up to 32 digits"
    return 1
  fi

  LC_ALL=C tr -dc '0-9' < /dev/urandom | head -c "${1}"
  echo ""
}

# generate random password with given length (up to 32)
rand_pass() {
  if [ -z "${1}" ]; then
    echo "error: set number of digits - e.g. rand_pass 12"
    return 1
  fi
  if (( ${1} > 32 )); then
    echo "error: only up to 32 digits"
    return 1
  fi

  head -c 500 /dev/urandom | LC_ALL=C tr -dc 'a-zA-Z0-9' | tr -d 'oOiI0' | head -c "${1}"
  echo ""
}

# set a terminal timer (terminal-notifier has to be installed)
timer() {
  if [ $# -ne 0 ] ; then
    if isCommandAvailable "terminal-notifier" ; then
      (sleep "$(echo "${1} * 60" | bc)" && terminal-notifier -title "TIMER" -message "You already finished ${1} minutes") &
      echo "set timer to ${1} minutes"
    else
      echo "error: terminal-notifier has to be installed"
      return
    fi
  else
    echo "error: timer needs an integer argument for the amount of minutes - e.g. timer 2"
    return
  fi
}

# keep the mac active for N minutes (default 60) - "keep -b N" runs it in the background, "keep stop" ends it
keep() {
  if [[ ${1} == stop ]] ; then
    pkill -f 'keep-loop [0-9]+$' && echo "stopped" || echo "nothing running"
    return 0
  fi

  local background=false
  if [[ ${1} == -b ]] ; then
    background=true
    shift
  fi

  local minutes=${1:-60}

  if [[ ! ${minutes} =~ ^[0-9]+$ ]] || (( minutes == 0 )) ; then
    echo "error: minutes have to be a positive integer - e.g. keep 90 or keep -b 90"
    return 1
  fi

  # 1px mouse move and back - only real HID input resets the idle time Teams reads, power assertions do not
  # exported instead of passed as argument, so the "keep-loop N" command line below stays matchable for keep stop
  local -x KEEP_JIGGLE='ObjC.import("CoreGraphics");
    const p = $.CGEventGetLocation($.CGEventCreate(null));
    const move = (x, y) => $.CGEventPost($.kCGHIDEventTap,
      $.CGEventCreateMouseEvent(null, $.kCGEventMouseMoved, {x: x, y: y}, $.kCGMouseButtonLeft));
    move(p.x + 1, p.y); move(p.x, p.y);'

  # own process with "keep-loop N" in its command line, so keep stop can find it without killing the interactive shell
  local loop='while (( SECONDS < $1 * 60 )) ; do osascript -l JavaScript -e "${KEEP_JIGGLE}" >/dev/null ; sleep 60 ; done'
  local end_time; end_time=$(date -v+${minutes}M +%H:%M)

  if ${background} ; then
    nohup zsh -c "${loop}" keep-loop "${minutes}" >/dev/null 2>&1 </dev/null &!
    echo "active in background until ${end_time} - stop with keep stop"
  else
    echo "active until ${end_time} - stop with ctrl+c or keep stop"
    zsh -c "${loop}" keep-loop "${minutes}"
    echo "done"
  fi
}

# sync a file or folder into a backup folder without some dev build folders/files
backup_sync() {
  if [ $# -ne 2 ] ; then
    echo "error: i need 2 parameters - one for file/folder and one for TARGET_FOLDER folder"
    return
  else
    if [[ ! -d "${2}" ]] ; then
      echo "error: no TARGET_FOLDER given"
      return
    else
      SOURCE="${1}"
      TARGET_FOLDER="${2}"
      LOG_FILE="${HOME}/backuplogs/$(date +%Y%m%d%H%M%S)_backup_sync.log"
      ERROR_FILE="${HOME}/backuplogs/$(date +%Y%m%d%H%M%S)_backup_sync_error.log"

      echo "start backup sync from ${1} to ${2}"

      # create backuplogs folder if not exists
      mkdir -p "${HOME}/backuplogs"

      # some dev folder excludes - a bit like .gitignore
      rsync -av --times --checksum --human-readable --itemize-changes --stats \
        --exclude 'build' --exclude 'out' --exclude 'target' --exclude 'dist' --exclude 'RemoteSystemsTempFiles' --exclude 'Servers' --exclude 'node_modules' --exclude '_site' \
        --exclude '.gradle' --exclude '.idea' --exclude '.metadata' --exclude '.recommenders'  --exclude '.settings' \
        --exclude '*.iml' --exclude '*.classpath' --exclude '*.project' --exclude '.DS_Store' \
        --out-format="[%t] %o %l Bytes - %f (last modified: %M)" "${SOURCE}" "${TARGET_FOLDER}" \
          > "${LOG_FILE}" 2> "${ERROR_FILE}"; [ -s "${ERROR_FILE}" ] || rm -f "${ERROR_FILE}"
      echo "backup sync done"
    fi
  fi
}

