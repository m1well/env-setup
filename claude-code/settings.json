{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(xargs -I{} echo {})",
      "Bash(xargs -I{} basename {})",
      "Bash(awk '$1>1')",
      "Bash(sort -t: -k2 -rn)",
      "Bash(awk -F: '{s+=$2} END {print s\" total\"}')",
      "Bash(awk '{s+=$1} END {print s}')"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npm publish:*)",
      "Bash(gh pr merge:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/id_rsa*)",
      "Read(**/*credentials*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Edit(.env)",
      "Edit(.env.*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "${HOME}/.claude/statusline.sh",
    "padding": 1
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/claude-sound.sh stop",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/git-autostage.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/claude-sound.sh notification",
            "async": true
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "language": "german",
  "theme": "dark"
}
